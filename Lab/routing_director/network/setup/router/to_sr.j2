deactivate protocols rsvp
deactivate protocols ldp
set protocols isis level 2 wide-metrics-only
set protocols isis source-packet-routing srgb start-label {{ label_start }}
set protocols isis source-packet-routing srgb index-range {{ label_range }}
set protocols isis source-packet-routing node-segment ipv4-index {{ label_index }}

set protocols pcep disable-multipath-capability
set protocols pcep pce rd1 spring-capability

set protocols source-packet-routing traffic-engineering database
set protocols source-packet-routing lsp-external-controller pccd

delete apply-groups
delete groups
